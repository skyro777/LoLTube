    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_banner_bg" />
        </shape>
    </item>
    <item android:left="24dp" android:top="55dp" android:right="212dp" android:bottom="55dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#FFB300" />
        </shape>
    </item>
    <item android:left="44dp" android:top="65dp" android:right="222dp" android:bottom="65dp">
        <shape android:shape="oval">
            <solid android:color="#0E0E12" />
        </shape>
    </item>
    <item android:left="128dp" android:top="76dp" android:right="60dp" android:bottom="76dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#FFB300" />
        </shape>
    </item>
</layer-list>
